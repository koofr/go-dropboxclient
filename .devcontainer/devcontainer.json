{
    "name": "go-dropboxclient",
    "image": "mcr.microsoft.com/devcontainers/base:trixie@sha256:41ff7ce12ec45f2704f27a6e091831186ad922ec8112e6339425bfefdf5a70f9",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "upgradePackages": true,
            "sudoers": true,
            "installSsl": true,
            "username": "vscode",
            "userUid": "automatic",
            "userGid": "automatic"
        },
        "ghcr.io/devcontainers/features/go:1": {
            "installGoTools": true,
            "version": "1.27.4"
        },
        "ghcr.io/devcontainers-extra/features/act:1": {
            "version": "0.2.98"
        },
        "ghcr.io/overlordtm/devcontainer-features/manage-packages:0": {
            "install": "podman-docker"
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "containerEnv": {
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "CONTAINER_HOST": "unix:///var/run/docker.sock"
    },
    "mounts": [
        // needs podman on host, enable with `systemctl --user enable --now podman.socket`
        "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/var/run/docker.sock,type=bind"
    ]
}